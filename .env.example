# Copy this file to `.env` (same directory as docker-compose.yml) before
# running `docker-compose up`. docker-compose loads `.env` automatically.
#
# Generate a real secret - the app refuses to start outside `development`
# with the placeholder value below (app/core/config.py):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
QS_SECRET_KEY=replace-with-a-generated-secret
